# Built gem artifacts — these must never be committed, or each release
# packages every previous release inside itself.
*.gem
/pkg/

# Bundler
/.bundle/

# Test and build output
/coverage/
/tmp/
/doc/
/.yardoc

# RSpec's example status file (used by --only-failures)
/spec/examples.txt

# Lockfiles for the per-Rack gemfiles are resolved fresh by CI
/gemfiles/*.lock
